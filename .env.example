# ============================================================
# .env.example — project environment variables template
# ============================================================
# Copy this file as .env and fill in the real values.
# NEVER commit the .env file to the repository.
# ============================================================

# --- Django ---

# Local/demo runs use the default settings module. Production deployments should
# set DJANGO_SETTINGS_MODULE=surfingproject.production_settings and provide all
# required production values below.
# DJANGO_SETTINGS_MODULE=surfingproject.settings

# Unique, long random key. Generate it, for example, with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="change-me-to-a-random-key"

# True only during local development. Set to False in production.
DEBUG=False

# List of hosts separated by commas.
# Production example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Local example:      ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_HOSTS=127.0.0.1,localhost

# Required by surfingproject.production_settings. Values must include scheme.
# Production example: CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# HTTPS hardening. For plain localhost HTTP keep these False / 0.
# For a real HTTPS deployment behind a reverse proxy, enable them.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Serve uploaded media through Django only for local/demo environments.
SERVE_MEDIA_LOCALLY=True

# --- Database ---
# Use PostgreSQL in Docker by default:
DB_ENGINE=postgresql
DB_NAME=surfing
DB_USER=surfing
DB_PASSWORD=surfing
DB_HOST=db
DB_PORT=5432

# Optional SQLite fallback:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# --- Demo bootstrap ---
# Set to 1 to auto-load demo users, spots, sessions, and gallery photos on startup.
RUN_DEMO_SEED=1

# Collect static assets during container startup.
RUN_COLLECTSTATIC=1

# --- Optional Docker-specific overrides ---
# Docker Compose intentionally uses DOCKER_* variables instead of the generic
# ones above, so your regular local .env does not accidentally weaken the
# container setup.
# DOCKER_SECRET_KEY=
# DOCKER_ALLOWED_HOSTS=127.0.0.1,localhost
# DOCKER_DB_NAME=surfing
# DOCKER_DB_USER=surfing
# DOCKER_DB_PASSWORD=surfing
# DOCKER_RUN_DEMO_SEED=1
